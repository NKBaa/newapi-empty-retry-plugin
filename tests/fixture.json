{
  "cases": [
    {
      "name": "empty JSON becomes retryable 400",
      "hook": "convertResponse",
      "args": [
        {},
        {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": "{\"choices\":[]}"
        }
      ],
      "expected": {
        "error": {
          "status": 400,
          "type": "invalid_request_error",
          "code": "empty_upstream_response",
          "message": "Upstream returned an empty response; mapped to retryable HTTP 400 empty_upstream_response"
        }
      }
    },
    {
      "name": "non-empty JSON passes through",
      "hook": "convertResponse",
      "args": [
        {},
        {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": "{\"choices\":[{\"message\":{\"content\":\"hello\"}}]}"
        }
      ],
      "expected": {
        "body": "{\"choices\":[{\"message\":{\"content\":\"hello\"}}]}",
        "contentType": "application/json"
      }
    },
    {
      "name": "role event is buffered",
      "hook": "convertStreamEvent",
      "args": [
        {
          "state": {
            "seen": false,
            "pending": []
          }
        },
        {
          "data": "{\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}"
        }
      ],
      "expected": {
        "state": {
          "seen": false,
          "pending": [
            {
              "data": "{\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}"
            }
          ]
        }
      }
    },
    {
      "name": "first content releases buffered events",
      "hook": "convertStreamEvent",
      "args": [
        {
          "state": {
            "seen": false,
            "pending": [
              {
                "data": "{\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}"
              }
            ]
          }
        },
        {
          "data": "{\"choices\":[{\"delta\":{\"content\":\"hello\"}}]}"
        }
      ],
      "expected": {
        "events": [
          {
            "data": "{\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}"
          },
          {
            "data": "{\"choices\":[{\"delta\":{\"content\":\"hello\"}}]}"
          }
        ],
        "state": {
          "seen": true,
          "pending": []
        }
      }
    },
    {
      "name": "empty stream ends as retryable 400",
      "hook": "convertStreamEvent",
      "args": [
        {
          "state": {
            "seen": false,
            "pending": [
              {
                "data": "{\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}"
              }
            ]
          }
        },
        {
          "done": true
        }
      ],
      "expected": {
        "error": {
          "status": 400,
          "type": "invalid_request_error",
          "code": "empty_upstream_response",
          "message": "Upstream returned an empty response; mapped to retryable HTTP 400 empty_upstream_response"
        }
      }
    },
    {
      "name": "non-empty stream ends normally",
      "hook": "convertStreamEvent",
      "args": [
        {
          "state": {
            "seen": true,
            "pending": []
          }
        },
        {
          "done": true
        }
      ],
      "expected": {
        "state": {
          "seen": true,
          "pending": []
        }
      }
    },
    {
      "name": "Gemini stream uses streamGenerateContent SSE",
      "hook": "convertRequest",
      "args": [
        {},
        {
          "path": "/v1beta/models/gemini-2.5-flash:streamGenerateContent",
          "body": {
            "contents": []
          },
          "model": "gemini-2.5-flash",
          "stream": true
        }
      ],
      "expected": {
        "body": {
          "contents": []
        },
        "contentType": "application/json",
        "stream": true,
        "state": {
          "seen": false,
          "pending": []
        },
        "path": "/v1beta/models/gemini-2.5-flash:streamGenerateContent?alt=sse"
      }
    },
    {
      "name": "Responses output item tool call is meaningful",
      "hook": "convertStreamEvent",
      "args": [
        {
          "state": {
            "seen": false,
            "pending": []
          }
        },
        {
          "data": "{\"type\":\"response.output_item.added\",\"item\":{\"type\":\"function_call\",\"name\":\"lookup\",\"call_id\":\"call_1\",\"arguments\":\"\"}}"
        }
      ],
      "expected": {
        "events": [
          {
            "data": "{\"type\":\"response.output_item.added\",\"item\":{\"type\":\"function_call\",\"name\":\"lookup\",\"call_id\":\"call_1\",\"arguments\":\"\"}}"
          }
        ],
        "state": {
          "seen": true,
          "pending": []
        }
      }
    }
  ]
}
